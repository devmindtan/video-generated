  "phraseRanges": [
    {
      "text": "Người làm bạn bực cả ngày chưa chắc đã nghe một lời trách móc.",
      "startSeconds": 0.3,
      "endSeconds": 2.979791666666667,
      "scene": 1
    },
    {
      "text": "Còn người ở nhà chờ bạn về lại phải chịu những câu nặng nề nhất.",
      "startSeconds": 3.364333333333333,
      "endSeconds": 6.776541666666667,
      "scene": 1
    },
    {
      "text": "Bạn đã nhịn suốt cả ngày. Về đến nhà, chỉ một câu hỏi cũng khiến bạn nổi nóng.",
      "startSeconds": 7.4952499999999995,
      "endSeconds": 11.909958333333334,
      "scene": 2
    },
    {
      "text": "Bạn quen với việc người thân sẽ nhường nhịn, sẽ hiểu mình,",
      "startSeconds": 12.262791666666667,
      "endSeconds": 15.036083333333334,
      "scene": 2
    },
    {
      "text": "nên để những bực dọc tuôn ra mà chẳng nghĩ nhiều đến cách họ đón nhận.",
      "startSeconds": 15.338916666666666,
      "endSeconds": 18.572625000000002,
      "scene": 2
    },
    {
      "text": "Nhưng bạn đâu biết rằng, lời cay nghiệt từ người thân có thể đau hơn rất nhiều lời khó nghe ngoài đường.",
      "startSeconds": 19.291333333333334,
      "endSeconds": 24.207541666666668,
      "scene": 3
    },
    {
      "text": "Vì người nói ra là người mình tin tưởng. Họ biết mình yếu lòng ở đâu.",
      "startSeconds": 24.660375,
      "endSeconds": 27.916541666666667,
      "scene": 3
    },
    {
      "text": "Và trong chính căn nhà của mình, chẳng ai muốn lúc nào cũng phải chuẩn bị tinh thần để chịu tổn thương.",
      "startSeconds": 28.269375,
      "endSeconds": 33.18358333333334,
      "scene": 3
    },
    {
      "text": "Bạn nói xong rồi hết giận. Người nghe vẫn phải sống cùng câu nói ấy.",
      "startSeconds": 33.95229166666667,
      "endSeconds": 37.602583333333335,
      "scene": 4
    },
    {
      "text": "Bạn thấy nhẹ đi vì đã nói hết những bực bội,",
      "startSeconds": 38.055416666666666,
      "endSeconds": 40.349125,
      "scene": 4
    },
    {
      "text": "còn họ bắt đầu cẩn trọng hơn, hỏi ít hơn, dè chừng cả những chuyện trước đây vẫn nói rất tự nhiên.",
      "startSeconds": 40.65195833333333,
      "endSeconds": 45.595125,
      "scene": 4
    },
    {
      "text": "Mệt mỏi cần được cảm thông.",
      "startSeconds": 46.36383333333333,
      "endSeconds": 47.81916666666667,
      "scene": 5
    },
    {
      "text": "Nhưng người thân cũng cần được đối xử tử tế, ngay cả trong ngày bạn chẳng còn chút kiên nhẫn nào.",
      "startSeconds": 48.172,
      "endSeconds": 52.88529166666667,
      "scene": 5
    },
    {
      "text": "Đừng để bạn được trở về là chính mình,",
      "startSeconds": 53.604,
      "endSeconds": 55.49679166666667,
      "scene": 6
    },
    {
      "text": "còn người thương bạn lại phải thu mình mỗi khi bạn trở về.",
      "startSeconds": 55.899625,
      "endSeconds": 58.599916666666665,
      "scene": 6
    }
  ],
