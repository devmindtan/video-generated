   "endMs": 505350
  },
  {
   "part": "06-moi-viec-mot-service",
   "text": "database, không cần mạng.",
   "startMs": 505350,
   "endMs": 507330
  },
  {
   "part": "06-moi-viec-mot-service",
   "text": "Test dễ viết thì người ta mới",
   "startMs": 507430,
   "endMs": 509330
  },
  {
   "part": "06-moi-viec-mot-service",
   "text": "dám sửa code.",
   "startMs": 509330,
   "endMs": 509990
  },
  {
   "part": "07-mui-ten-chi-huong-vao-trong",
   "text": "Bây giờ lùi lại nhìn cả hệ thống.",
