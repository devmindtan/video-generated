  "phraseRanges": [
    {
      "text": "Có người vừa kể rằng họ đang rất mệt, bạn đã vội chỉ ra họ nên làm gì, đáng lẽ phải nghĩ thế nào.",
      "startSeconds": 0.45,
      "endSeconds": 5.967083333333333,
      "scene": 1
    },
    {
      "text": "Bạn muốn giúp. Nhưng chưa nghe hết câu chuyện, bạn đã biến nỗi buồn của họ thành một bài toán cần giải.",
      "startSeconds": 6.699208333333333,
      "endSeconds": 11.745708333333333,
      "scene": 2
    },
    {
      "text": "Họ phải giải thích thêm, rồi tự bảo vệ cảm xúc của mình.",
      "startSeconds": 12.962458333333334,
      "endSeconds": 15.980666666666666,
      "scene": 3
    },
    {
      "text": "Cuối cùng, người cần được an ủi lại thấy mình như đang bị chấm điểm.",
      "startSeconds": 16.731916666666667,
      "endSeconds": 20.006,
      "scene": 3
    },
    {
      "text": "Đôi khi, họ biết mình cần làm gì rồi. Chỉ là hôm nay, họ chưa đủ sức để làm.",
      "startSeconds": 21.22275,
      "endSeconds": 25.715958333333333,
      "scene": 4
    },
    {
      "text": "Điều họ tìm ở bạn có thể chỉ là một nơi được nói thật rằng mình đang không ổn, mà không phải nghe thêm mình đã sai ở đâu.",
      "startSeconds": 26.567291666666666,
      "endSeconds": 32.901291666666665,
      "scene": 4
    },
    {
      "text": "Trước khi đưa lời khuyên, thử hỏi: Bạn muốn mình cùng tìm cách, hay chỉ cần mình ngồi nghe?",
      "startSeconds": 33.93804166666666,
      "endSeconds": 38.528625,
      "scene": 5
    },
    {
      "text": "Được thấu hiểu có khi chính là điều giúp một người đủ sức bắt đầu giải quyết chuyện của họ.",
      "startSeconds": 39.575375,
      "endSeconds": 44.15,
      "scene": 6
    }
  ],
