  "phraseRanges": [
    {
      "text": "Lần đầu bạn xin lỗi, người ta tin là bạn đã hiểu. Lần thứ hai, họ nghĩ ai cũng cần thời gian để thay đổi.",
      "startSeconds": 0.25,
      "endSeconds": 6.005583333333333,
      "scene": 1
    },
    {
      "text": "Nhưng rồi vẫn chuyện ấy xảy ra, vẫn họ tổn thương, vẫn bạn nói mình không cố ý.",
      "startSeconds": 7.24675,
      "endSeconds": 11.517083333333334,
      "scene": 2
    },
    {
      "text": "Đến một lúc, điều khiến họ mệt không còn là lỗi lầm ấy nữa.",
      "startSeconds": 12.709916666666668,
      "endSeconds": 15.743208333333335,
      "scene": 3
    },
    {
      "text": "Mà là mỗi lần tin bạn, họ lại phải chịu thêm một lần thất vọng.",
      "startSeconds": 16.48766666666667,
      "endSeconds": 19.74395833333333,
      "scene": 3
    },
    {
      "text": "Bạn thấy họ lạnh nhạt, ít nói, không còn muốn tranh luận.",
      "startSeconds": 20.936791666666668,
      "endSeconds": 23.706,
      "scene": 4
    },
    {
      "text": "Có thể vì những điều cần nói, họ đã nói hết từ những lần trước.",
      "startSeconds": 24.45054166666667,
      "endSeconds": 27.749958333333336,
      "scene": 4
    },
    {
      "text": "Một lời xin lỗi chỉ có ý nghĩa khi nó khiến lần sau khác đi.",
      "startSeconds": 28.94279166666667,
      "endSeconds": 31.972,
      "scene": 5
    },
    {
      "text": "Họ đã tin lời xin lỗi của bạn đủ nhiều rồi.",
      "scene": 5,
      "startSeconds": 32.716458333333335,
      "endSeconds": 34.854375
    },
    {
      "text": "Điều họ cần bây giờ là được ở bên bạn mà không phải lo chuyện cũ sẽ lặp lại.",
      "scene": 6,
      "startSeconds": 35.404375,
      "endSeconds": 39.160875
    },
    {
      "text": "Đừng để người đã chọn tha thứ lại phải hối hận vì đã tin mình.",
      "scene": 6,
      "startSeconds": 39.860875,
      "endSeconds": 43.053958333333334
    }
