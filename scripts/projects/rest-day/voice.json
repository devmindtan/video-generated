  "phraseRanges": [
    {
      "text": "Ngày nghỉ, bạn vừa nằm xuống đã nghĩ đến những việc chưa làm. Nghỉ thêm một lát cũng thấy mình đang lãng phí thời gian.",
      "startSeconds": 0.25,
      "endSeconds": 5.763791666666667,
      "scene": 1
    },
    {
      "text": "Bạn quen đo giá trị bản thân bằng kết quả, nên chẳng làm gì lại thấy mình vô dụng.",
      "startSeconds": 7.401708333333334,
      "endSeconds": 11.520708333333333,
      "scene": 2
    },
    {
      "text": "Nhưng hãy nhớ lúc quá mệt: đọc một đoạn ba lần vẫn không hiểu, làm sai rồi mất cả buổi sửa lại.",
      "startSeconds": 12.94525,
      "endSeconds": 17.938041666666667,
      "scene": 3
    },
    {
      "text": "Bạn bỏ thêm thời gian, nhưng chỉ đang trả giá cho việc không chịu nghỉ.",
      "startSeconds": 18.899250000000002,
      "endSeconds": 22.366041666666668,
      "scene": 3
    },
    {
      "text": "Nghỉ ngơi giúp bạn lấy lại sức lực và sự tập trung, kể cả khi công việc chưa xong.",
      "startSeconds": 23.840583333333335,
      "endSeconds": 27.919583333333332,
      "scene": 4
    },
    {
      "text": "Bạn thương người thân vất vả, chỉ mong họ được nghỉ. Vậy sao với bản thân, bạn lại đợi đến kiệt sức?",
      "startSeconds": 29.344125,
      "endSeconds": 34.77791666666667,
      "scene": 5
    },
    {
      "text": "Một ngày nghỉ đâu cần thành tích mới có giá trị.",
      "startSeconds": 36.302458333333334,
      "endSeconds": 38.77375,
      "scene": 6
    },
    {
      "text": "Bạn cần được chăm sóc cả trước khi mình không còn sức để làm thêm điều gì nữa.",
      "startSeconds": 39.83495833333333,
      "endSeconds": 43.75004166666667,
      "scene": 6
    }
  ],
