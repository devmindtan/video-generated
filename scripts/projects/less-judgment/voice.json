  "phraseRanges": [
    {
      "text": "Bạn đang uống cà phê.",
      "startSeconds": 0.3,
      "endSeconds": 1.4972,
      "scene": 1
    },
    {
      "text": "Người đối diện liếc sang bàn bên: Ăn mặc thế kia mà cũng ra đường.",
      "startSeconds": 2.0886583333333335,
      "endSeconds": 5.486758333333333,
      "scene": 1
    },
    {
      "text": "Rồi kể chuyện người quen nghỉ việc: Đang ổn định lại bỏ, nghĩ gì không biết.",
      "startSeconds": 6.178216666666667,
      "endSeconds": 9.771208333333334,
      "scene": 1
    },
    {
      "text": "Bạn không biết rõ hai người đó.",
      "startSeconds": 10.788683333333333,
      "endSeconds": 12.377183333333333,
      "scene": 2
    },
    {
      "text": "Nhưng vẫn góp vài câu cho hợp chuyện.",
      "startSeconds": 12.968641666666667,
      "endSeconds": 14.817241666666666,
      "scene": 2
    },
    {
      "text": "Cứ thế, cuộc trò chuyện chỉ còn là những lời khen chê người vắng mặt.",
      "startSeconds": 15.4587,
      "endSeconds": 18.741791666666668,
      "scene": 2
    },
    {
      "text": "Bộ đồ ấy có thể chỉ là sở thích.",
      "startSeconds": 20.299466666666667,
      "endSeconds": 22.109566666666666,
      "scene": 3
    },
    {
      "text": "Quyết định nghỉ việc có thể đã được cân nhắc nhiều tháng.",
      "startSeconds": 22.701025,
      "endSeconds": 25.341625,
      "scene": 3
    },
    {
      "text": "Chỉ nghe vài câu, mình chưa thể hiểu hết chuyện của họ.",
      "startSeconds": 25.983083333333333,
      "endSeconds": 28.679683333333333,
      "scene": 3
    },
    {
      "text": "Không cần phản bác cho căng thẳng.",
      "startSeconds": 29.841849999999997,
      "endSeconds": 31.508249999999997,
      "scene": 4
    },
    {
      "text": "Bạn có thể nói: Chuyện của họ, mình cũng không rõ.",
      "startSeconds": 32.09970833333333,
      "endSeconds": 34.79900833333333,
      "scene": 4
    },
    {
      "text": "Rồi hỏi: Dạo này bạn thế nào?",
      "startSeconds": 35.49046666666667,
      "endSeconds": 37.405966666666664,
      "scene": 4
    },
    {
      "text": "Đưa cuộc nói chuyện trở về người đang ngồi trước mặt.",
      "startSeconds": 38.31813333333333,
      "endSeconds": 40.63083333333333,
      "scene": 4
    },
    {
      "text": "Bạn không cần một lời nhận xét cho mọi chuyện mình nhìn thấy.",
      "startSeconds": 41.572291666666665,
      "endSeconds": 44.36219166666667,
      "scene": 5
    },
    {
      "text": "Một buổi gặp gỡ đâu cần trở thành buổi chấm điểm những người vắng mặt.",
      "startSeconds": 45.32435833333333,
      "endSeconds": 48.60015833333333,
      "scene": 5
    }
  ],
