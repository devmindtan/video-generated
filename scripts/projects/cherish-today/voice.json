  "phraseRanges": [
    {
      "text": "Đôi khi, điều ta mong mỏi nhất lại chỉ là được sống thêm một ngày bình thường bên người mình thương.",
      "scene": 1,
      "startSeconds": 0.3,
      "endSeconds": 5.1405
    },
    {
      "text": "Ta cứ hẹn một bữa cơm, để dành một chuyến đi, nghĩ rằng đợi bớt bận rồi sẽ dành thời gian cho nhau nhiều hơn.",
      "scene": 2,
      "startSeconds": 6.289208333333333,
      "endSeconds": 11.522791666666667
    },
    {
      "text": "Nhưng trong lúc ta chờ một dịp thuận tiện, người mình thương cũng đang già đi, đang mỏi mệt, và có những lúc cần mình mà chẳng nói ra.",
      "scene": 3,
      "startSeconds": 12.6715,
      "endSeconds": 19.45970833333333
    },
    {
      "text": "Có khi chỉ mong mình ngồi thêm một lát, nghe hết câu chuyện, hoặc nhớ gọi về mà không cần có việc gì.",
      "scene": 4,
      "startSeconds": 20.608416666666667,
      "endSeconds": 25.770208333333333
    },
    {
      "text": "Chẳng ai biết ngày mai sẽ ra sao.",
      "scene": 5,
      "startSeconds": 26.918916666666664,
      "endSeconds": 28.762124999999997
    },
    {
      "text": "Khi vẫn còn có nhau trong đời, đừng xem sự hiện diện của nhau là điều hiển nhiên, rồi cứ để những điều muốn làm cùng nhau chờ mãi.",
      "scene": 5,
      "startSeconds": 29.49575,
      "endSeconds": 36.05283333333333
    },
    {
      "text": "Hãy để người mình thương cảm nhận được tình thương ấy ngay hôm nay,",
      "scene": 6,
      "startSeconds": 37.20154166666667,
      "endSeconds": 39.97591666666667
    },
    {
      "text": "để những lời chưa nói không phải bắt đầu bằng hai chữ giá như.",
      "scene": 6,
      "startSeconds": 40.70954166666667,
      "endSeconds": 43.599875000000004
    }
