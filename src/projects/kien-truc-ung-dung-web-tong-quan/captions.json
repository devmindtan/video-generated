   "endMs": 525510
  },
  {
   "part": "07-mui-ten-chi-huong-vao-trong",
   "text": "này sang tầng khác.",
   "startMs": 525510,
   "endMs": 526590
  },
  {
   "part": "07-mui-ten-chi-huong-vao-trong",
   "text": "Còn chia quá nhiều lớp thì thành",
   "startMs": 527090,
   "endMs": 528870
  },
  {
   "part": "07-mui-ten-chi-huong-vao-trong",
   "text": "mã lasagna, lớp chồng lớp, khó lần theo.",
   "startMs": 528870,
   "endMs": 531990
  },
  {
   "part": "07-mui-ten-chi-huong-vao-trong",
   "text": "Sách xếp lại thành ba vòng, nghiệp",
   "startMs": 533270,
   "endMs": 535350
  },
  {
   "part": "07-mui-ten-chi-huong-vao-trong",
   "text": "vụ nằm ở chính giữa.",
   "startMs": 535350,
   "endMs": 536530
  },
  {
   "part": "07-mui-ten-chi-huong-vao-trong",
   "text": "Vòng trong cùng là Domain: đơn hàng,",
   "startMs": 537130,
   "endMs": 539150
  },
  {
   "part": "07-mui-ten-chi-huong-vao-trong",
   "text": "giá trị, luật bán hàng.",
   "startMs": 539430,
   "endMs": 540830
  },
  {
   "part": "07-mui-ten-chi-huong-vao-trong",
   "text": "Vòng này không dùng tới framework.",
   "startMs": 540830,
   "endMs": 543510
  },
  {
   "part": "07-mui-ten-chi-huong-vao-trong",
   "text": "Vòng giữa là Application: các service",
   "startMs": 543790,
   "endMs": 546370
  },
  {
   "part": "07-mui-ten-chi-huong-vao-trong",
   "text": "cho từng việc, như lớp keo nối",
   "startMs": 546370,
   "endMs": 548430
  },
  {
   "part": "07-mui-ten-chi-huong-vao-trong",
   "text": "mọi thứ lại.",
   "startMs": 548430,
   "endMs": 549130
  },
  {
   "part": "07-mui-ten-chi-huong-vao-trong",
   "text": "Vòng ngoài là Infrastructure:",
   "startMs": 549670,
   "endMs": 551430
  },
  {
   "part": "07-mui-ten-chi-huong-vao-trong",
   "text": "framework, database, gửi mail, và các",
   "startMs": 551730,
   "endMs": 554450
  },
  {
   "part": "07-mui-ten-chi-huong-vao-trong",
   "text": "nhà kho cụ thể.",
   "startMs": 554450,
   "endMs": 555350
  },
  {
   "part": "07-mui-ten-chi-huong-vao-trong",
   "text": "Chỉ có một luật, gọi là Dependency",
   "startMs": 556630,
   "endMs": 558970
  },
  {
   "part": "07-mui-ten-chi-huong-vao-trong",
   "text": "Rule: mũi tên phụ thuộc chỉ được",
   "startMs": 558970,
   "endMs": 561010
  },
  {
   "part": "07-mui-ten-chi-huong-vao-trong",
   "text": "chỉ vào trong.",
   "startMs": 561010,
   "endMs": 561670
  },
  {
   "part": "07-mui-ten-chi-huong-vao-trong",
   "text": "Vòng ngoài biết vòng trong.",
   "startMs": 562370,
   "endMs": 563730
  },
  {
   "part": "07-mui-ten-chi-huong-vao-trong",
   "text": "Vòng trong không biết gì về vòng ngoài.",
   "startMs": 564290,
   "endMs": 566690
  },
  {
   "part": "07-mui-ten-chi-huong-vao-trong",
   "text": "Nhà kho MySQL ở ngoài làm theo",
   "startMs": 566690,
   "endMs": 569650
  },
  {
   "part": "07-mui-ten-chi-huong-vao-trong",
   "text": "hợp đồng của Domain, còn Domain không",
   "startMs": 569650,
   "endMs": 572450
  },
  {
   "part": "07-mui-ten-chi-huong-vao-trong",
   "text": "cần biết ai đang làm việc đó.",
   "startMs": 572450,
   "endMs": 574190
  },
  {
   "part": "07-mui-ten-chi-huong-vao-trong",
   "text": "Sách gọi tinh thần này là Hollywood",
   "startMs": 574810,
   "endMs": 576950
  },
  {
   "part": "07-mui-ten-chi-huong-vao-trong",
   "text": "Principle: đừng gọi chúng tôi, chúng",
   "startMs": 576950,
   "endMs": 579730
  },
  {
   "part": "07-mui-ten-chi-huong-vao-trong",
   "text": "tôi sẽ gọi bạn.",
   "startMs": 579730,
   "endMs": 580610
  },
  {
   "part": "07-mui-ten-chi-huong-vao-trong",
   "text": "Các vòng được ráp lại ở một",
   "startMs": 581750,
   "endMs": 583450
  },
  {
   "part": "07-mui-ten-chi-huong-vao-trong",
   "text": "chỗ khai báo duy nhất.",
   "startMs": 583450,
   "endMs": 584630
  },
  {
   "part": "07-mui-ten-chi-huong-vao-trong",
   "text": "Chạy thật thì đưa kho MySQL, chạy",
   "startMs": 585110,
   "endMs": 588070
  },
  {
   "part": "07-mui-ten-chi-huong-vao-trong",
   "text": "test thì đưa kho trong bộ nhớ.",
   "startMs": 588070,
   "endMs": 589710
  },
  {
   "part": "07-mui-ten-chi-huong-vao-trong",
   "text": "Và sách cũng nhắc: không phải việc",
   "startMs": 590310,
   "endMs": 592230
  },
  {
   "part": "07-mui-ten-chi-huong-vao-trong",
   "text": "gì cũng cần đủ ba vòng.",
   "startMs": 592230,
   "endMs": 594070
  },
  {
   "part": "07-mui-ten-chi-huong-vao-trong",
   "text": "Việc đơn giản thì gộp lại cho",
   "startMs": 594070,
   "endMs": 596210
  },
  {
   "part": "07-mui-ten-chi-huong-vao-trong",
   "text": "đỡ rối, chỉ phần lõi phức tạp",
   "startMs": 596210,
   "endMs": 598370
  },
  {
   "part": "07-mui-ten-chi-huong-vao-trong",
   "text": "mới đáng chia đủ.",
   "startMs": 598370,
   "endMs": 599170
  },
  {
   "part": "08-o-cam-usb-ports-and-adapters",
   "text": "Chương cuối đưa một cách nhìn gọn",
   "startMs": 600620,
   "endMs": 602620
  },
  {
   "part": "08-o-cam-usb-ports-and-adapters",
   "text": "hơn nữa: Hexagonal Architecture.",
   "startMs": 602620,
   "endMs": 605360
  },
  {
   "part": "08-o-cam-usb-ports-and-adapters",
   "text": "Alistair Cockburn đề xuất nó năm 2005.",
   "startMs": 605360,
   "endMs": 609720
  },
  {
   "part": "08-o-cam-usb-ports-and-adapters",
   "text": "Hình lục giác chỉ là cách vẽ,",
   "startMs": 610580,
   "endMs": 612240
  },
  {
   "part": "08-o-cam-usb-ports-and-adapters",
   "text": "hệ thống không cần có sáu cạnh.",
   "startMs": 612440,
   "endMs": 614240
  },
  {
   "part": "08-o-cam-usb-ports-and-adapters",
   "text": "Hãy nghĩ tới cổng USB trên máy tính.",
   "startMs": 614760,
   "endMs": 617560
  },
  {
   "part": "08-o-cam-usb-ports-and-adapters",
   "text": "Máy không cần biết bạn cắm chuột,",
   "startMs": 617780,
   "endMs": 619360
  },
  {
   "part": "08-o-cam-usb-ports-and-adapters",
   "text": "bàn phím hay ổ cứng.",
   "startMs": 619720,
   "endMs": 621080
  },
  {
   "part": "08-o-cam-usb-ports-and-adapters",
   "text": "Nó chỉ biết một chuẩn cắm.",
   "startMs": 621680,
   "endMs": 623620
  },
  {
   "part": "08-o-cam-usb-ports-and-adapters",
   "text": "Phần nghiệp vụ là cái máy ở giữa.",
   "startMs": 624280,
   "endMs": 626960
  },
  {
   "part": "08-o-cam-usb-ports-and-adapters",
   "text": "Các chuẩn cắm gọi là port.",
   "startMs": 627140,
   "endMs": 629180
  },
  {
   "part": "08-o-cam-usb-ports-and-adapters",
   "text": "Mỗi thiết bị cụ thể cắm vào",
   "startMs": 629180,
   "endMs": 630720
  },
  {
   "part": "08-o-cam-usb-ports-and-adapters",
   "text": "gọi là adapter.",
   "startMs": 630720,
   "endMs": 631740
  },
  {
   "part": "08-o-cam-usb-ports-and-adapters",
   "text": "Có port để thế giới gọi vào:",
   "startMs": 632340,
   "endMs": 633980
  },
  {
   "part": "08-o-cam-usb-ports-and-adapters",
   "text": "trang web, API, dòng lệnh, bài test.",
   "startMs": 634240,
   "endMs": 637100
  },
  {
   "part": "08-o-cam-usb-ports-and-adapters",
   "text": "Và có port để lõi gọi ra:",
   "startMs": 637680,
   "endMs": 639280
  },
  {
   "part": "08-o-cam-usb-ports-and-adapters",
   "text": "lưu đơn, gửi thông báo, gọi dịch",
   "startMs": 639740,
   "endMs": 642000
  },
  {
   "part": "08-o-cam-usb-ports-and-adapters",
   "text": "vụ bên ngoài.",
   "startMs": 642000,
   "endMs": 642600
  },
  {
   "part": "08-o-cam-usb-ports-and-adapters",
   "text": "Trong ví dụ của sách, lưu đơn",
   "startMs": 643860,
   "endMs": 645700
  },
  {
   "part": "08-o-cam-usb-ports-and-adapters",
   "text": "là một port, cắm được hai adapter:",
   "startMs": 645700,
   "endMs": 648160
  },
  {
   "part": "08-o-cam-usb-ports-and-adapters",
   "text": "MySQL khi chạy thật, bộ nhớ khi test.",
   "startMs": 648620,
   "endMs": 651840
  },
  {
   "part": "08-o-cam-usb-ports-and-adapters",
   "text": "Gửi xác nhận đơn là port thứ",
   "startMs": 651840,
   "endMs": 653960
  },
  {
   "part": "08-o-cam-usb-ports-and-adapters",
   "text": "hai: một adapter gửi email thật, một",
   "startMs": 653960,
   "endMs": 657080
  },
  {
   "part": "08-o-cam-usb-ports-and-adapters",
   "text": "adapter chỉ ghi log khi test.",
   "startMs": 657080,
   "endMs": 659080
  },
  {
   "part": "08-o-cam-usb-ports-and-adapters",
   "text": "Nên bài test đặt hàng chỉ cần",
   "startMs": 659640,
   "endMs": 661840
  },
  {
   "part": "08-o-cam-usb-ports-and-adapters",
   "text": "hai adapter giả, không phải khởi động Laravel.",
   "startMs": 661840,
   "endMs": 665100
  },
  {
   "part": "08-o-cam-usb-ports-and-adapters",
   "text": "Theo sách, Cockburn nghĩ ra mô hình",
   "startMs": 665300,
   "endMs": 667360
  },
  {
   "part": "08-o-cam-usb-ports-and-adapters",
   "text": "này trước hết để test cho dễ.",
   "startMs": 667360,
   "endMs": 670120
  },
  {
   "part": "08-o-cam-usb-ports-and-adapters",
   "text": "Cái hay lộ ra khi cần mở rộng.",
   "startMs": 670120,
   "endMs": 672780
  },
  {
   "part": "08-o-cam-usb-ports-and-adapters",
   "text": "Muốn nhập đơn từ file CSV: viết",
   "startMs": 673320,
   "endMs": 675720
  },
  {
   "part": "08-o-cam-usb-ports-and-adapters",
   "text": "thêm một adapter đọc file, lõi đặt",
   "startMs": 675720,
   "endMs": 678500
  },
  {
   "part": "08-o-cam-usb-ports-and-adapters",
   "text": "hàng giữ nguyên.",
   "startMs": 678500,
   "endMs": 679720
  },
  {
   "part": "08-o-cam-usb-ports-and-adapters",
   "text": "Muốn lưu song song hai database: thêm",
   "startMs": 679920,
   "endMs": 682220
  },
  {
   "part": "08-o-cam-usb-ports-and-adapters",
   "text": "một adapter nữa cho cùng một port.",
   "startMs": 682220,
   "endMs": 684340
  },
  {
   "part": "08-o-cam-usb-ports-and-adapters",
   "text": "Phần đặt hàng cần nói chuyện với",
   "startMs": 684900,
   "endMs": 686540
  },
  {
   "part": "08-o-cam-usb-ports-and-adapters",
   "text": "phần khách hàng: đi qua một port,",
   "startMs": 686540,
   "endMs": 688700
  },
  {
   "part": "08-o-cam-usb-ports-and-adapters",
   "text": "không chọc thẳng vào database của nhau.",
   "startMs": 689020,
   "endMs": 691440
  },
  {
   "part": "08-o-cam-usb-ports-and-adapters",
   "text": "Cách áp dụng có bốn bước: tìm",
   "startMs": 692640,
   "endMs": 694400
  },
  {
   "part": "08-o-cam-usb-ports-and-adapters",
   "text": "các port, viết hợp đồng cho chúng",
   "startMs": 694400,
   "endMs": 696160
  },
  {
   "part": "08-o-cam-usb-ports-and-adapters",
   "text": "ở phía lõi, viết adapter, rồi ráp",
   "startMs": 696160,
   "endMs": 699060
  },
  {
   "part": "08-o-cam-usb-ports-and-adapters",
   "text": "lại ở một chỗ.",
   "startMs": 699060,
   "endMs": 699940
  },
  {
   "part": "09-dung-lam-qua-bat-dau-nho",
   "text": "Cái giá cũng có, và sách nói thẳng.",
   "startMs": 701410,
   "endMs": 704610
  },
  {
   "part": "09-dung-lam-qua-bat-dau-nho",
   "text": "Nhiều interface hơn, nhiều class hơn.",
   "startMs": 704810,
   "endMs": 707130
  },
  {
   "part": "09-dung-lam-qua-bat-dau-nho",
   "text": "Không có quy ước đặt tên thì sẽ rối.",
   "startMs": 707690,
   "endMs": 709950
  },
  {
   "part": "09-dung-lam-qua-bat-dau-nho",
   "text": "Và đừng trừu tượng hóa mọi thứ:",
   "startMs": 710490,
   "endMs": 712310
  },
  {
   "part": "09-dung-lam-qua-bat-dau-nho",
   "text": "chỉ tách ở chỗ hay thay đổi",
   "startMs": 712610,
   "endMs": 714330
  },
  {
   "part": "09-dung-lam-qua-bat-dau-nho",
   "text": "hoặc khó test.",
   "startMs": 714530,
   "endMs": 715270
  },
  {
   "part": "09-dung-lam-qua-bat-dau-nho",
   "text": "Nếu chỉ nhớ một điều từ cuốn",
   "startMs": 716510,
   "endMs": 718130
  },
  {
   "part": "09-dung-lam-qua-bat-dau-nho",
   "text": "sách, hãy nhớ phép thử này.",
   "startMs": 718130,
   "endMs": 720110
  },
  {
   "part": "09-dung-lam-qua-bat-dau-nho",
   "text": "Đoạn code này có chạy được một",
   "startMs": 720590,
   "endMs": 722210
  },
  {
   "part": "09-dung-lam-qua-bat-dau-nho",
   "text": "mình, trong bộ nhớ, không cần gì",
   "startMs": 722210,
   "endMs": 724630
  },
  {
   "part": "09-dung-lam-qua-bat-dau-nho",
   "text": "bên ngoài không?",
   "startMs": 724630,
   "endMs": 725390
  },
  {
   "part": "09-dung-lam-qua-bat-dau-nho",
   "text": "Có, thì giữ nó sạch ở giữa.",
   "startMs": 725390,
   "endMs": 728250
  },
  {
   "part": "09-dung-lam-qua-bat-dau-nho",
   "text": "Không, thì đẩy nó ra rìa, đứng",
   "startMs": 728630,
   "endMs": 730810
  },
  {
   "part": "09-dung-lam-qua-bat-dau-nho",
