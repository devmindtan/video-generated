  {
   "part": "03-de-don-hang-tu-giu-luat",
   "text": "tra: mã e-book phải hợp lệ, email",
   "startMs": 239980,
   "endMs": 242720
  },
  {
   "part": "03-de-don-hang-tu-giu-luat",
   "text": "phải đúng định dạng, số lượng phải",
   "startMs": 242720,
   "endMs": 244760
  },
  {
   "part": "03-de-don-hang-tu-giu-luat",
   "text": "lớn hơn không, giá không được âm.",
   "startMs": 244760,
   "endMs": 247280
  },
  {
   "part": "03-de-don-hang-tu-giu-luat",
   "text": "Sai một điều, nó từ chối ra đời.",
   "startMs": 247500,
   "endMs": 250120
  },
  {
   "part": "03-de-don-hang-tu-giu-luat",
   "text": "Tổng tiền cũng do chính nó tính.",
   "startMs": 250360,
   "endMs": 252400
  },
  {
   "part": "03-de-don-hang-tu-giu-luat",
   "text": "Điều đáng giá nhất nằm ở đây:",
   "startMs": 253560,
   "endMs": 255260
  },
  {
   "part": "03-de-don-hang-tu-giu-luat",
   "text": "trong cả hệ thống, không còn cách",
   "startMs": 255600,
   "endMs": 257420
  },
  {
   "part": "03-de-don-hang-tu-giu-luat",
   "text": "nào tạo ra một đơn hàng sai.",
   "startMs": 257420,
   "endMs": 259260
  },
  {
   "part": "03-de-don-hang-tu-giu-luat",
   "text": "Từ trang web, từ API hay từ",
   "startMs": 259760,
   "endMs": 262140
  },
  {
   "part": "03-de-don-hang-tu-giu-luat",
   "text": "bài test, ai muốn có đơn hàng",
   "startMs": 262140,
   "endMs": 264160
  },
  {
   "part": "03-de-don-hang-tu-giu-luat",
   "text": "cũng phải đi qua đúng một cửa ấy.",
   "startMs": 264160,
   "endMs": 266060
  },
  {
   "part": "03-de-don-hang-tu-giu-luat",
   "text": "Luật nằm một chỗ, thay vì chép",
   "startMs": 266060,
   "endMs": 268560
  },
  {
   "part": "03-de-don-hang-tu-giu-luat",
   "text": "rải rác khắp các controller.",
   "startMs": 268560,
   "endMs": 270240
  },
  {
   "part": "03-de-don-hang-tu-giu-luat",
   "text": "Sách còn phân biệt hai loại đối tượng.",
   "startMs": 271540,
   "endMs": 273660
  },
  {
   "part": "03-de-don-hang-tu-giu-luat",
   "text": "Entity là thứ có danh tính: hai",
   "startMs": 274280,
   "endMs": 276780
  },
  {
   "part": "03-de-don-hang-tu-giu-luat",
   "text": "đơn hàng giống hệt nhau nhưng khác",
   "startMs": 276780,
   "endMs": 278760
  },
  {
   "part": "03-de-don-hang-tu-giu-luat",
   "text": "mã thì vẫn là hai đơn.",
   "startMs": 278760,
   "endMs": 280380
  },
  {
   "part": "03-de-don-hang-tu-giu-luat",
   "text": "Value object chỉ là một giá trị:",
   "startMs": 280940,
   "endMs": 283080
  },
  {
   "part": "03-de-don-hang-tu-giu-luat",
   "text": "hai địa chỉ email giống nhau là một.",
   "startMs": 283320,
   "endMs": 285520
  },
  {
   "part": "03-de-don-hang-tu-giu-luat",
   "text": "Gói email vào value object, nó được",
   "startMs": 286180,
   "endMs": 288800
  },
  {
   "part": "03-de-don-hang-tu-giu-luat",
   "text": "kiểm tra định dạng ngay lúc tạo.",
   "startMs": 288800,
   "endMs": 290800
  },
  {
   "part": "03-de-don-hang-tu-giu-luat",
   "text": "Gói số tiền kèm đơn vị tiền",
   "startMs": 291000,
   "endMs": 292620
  },
  {
   "part": "03-de-don-hang-tu-giu-luat",
   "text": "tệ, sẽ khó cộng nhầm đồng với đô.",
   "startMs": 292620,
   "endMs": 295340
  },
  {
   "part": "03-de-don-hang-tu-giu-luat",
   "text": "Cả hai cùng một tinh thần: đặt",
   "startMs": 295340,
   "endMs": 297320
  },
  {
   "part": "03-de-don-hang-tu-giu-luat",
   "text": "luật ở đúng nơi giá trị sinh ra.",
   "startMs": 297320,
   "endMs": 299160
  },
  {
   "part": "04-nha-kho-cho-don-hang-repository",
   "text": "Đơn hàng đã tự giữ luật, nhưng",
   "startMs": 300590,
   "endMs": 303270
  },
  {
   "part": "04-nha-kho-cho-don-hang-repository",
   "text": "vẫn phải được lưu lại.",
   "startMs": 303270,
   "endMs": 304590
  },
  {
   "part": "04-nha-kho-cho-don-hang-repository",
   "text": "Sách không cho đơn hàng tự gọi database.",
   "startMs": 305010,
   "endMs": 307310
  },
  {
   "part": "04-nha-kho-cho-don-hang-repository",
   "text": "Việc lưu giao cho một thứ gọi là repository.",
   "startMs": 308070,
   "endMs": 310990
  },
  {
   "part": "04-nha-kho-cho-don-hang-repository",
   "text": "Cứ hình dung nó như một nhà kho.",
   "startMs": 311630,
   "endMs": 313470
  },
  {
   "part": "04-nha-kho-cho-don-hang-repository",
   "text": "Phía nghiệp vụ chỉ nói với nhà",
   "startMs": 314430,
   "endMs": 316930
  },
  {
   "part": "04-nha-kho-cho-don-hang-repository",
   "text": "kho hai câu: cất đơn này giúp",
   "startMs": 316930,
   "endMs": 318830
  },
  {
   "part": "04-nha-kho-cho-don-hang-repository",
   "text": "tôi, và đưa tôi đơn số mấy.",
   "startMs": 318830,
   "endMs": 321350
  },
  {
   "part": "04-nha-kho-cho-don-hang-repository",
   "text": "Không nói bảng nào, cột nào, câu SQL nào.",
   "startMs": 321530,
   "endMs": 324970
  },
  {
   "part": "04-nha-kho-cho-don-hang-repository",
   "text": "Hai câu đó được viết thành một",
   "startMs": 325510,
   "endMs": 327110
  },
  {
   "part": "04-nha-kho-cho-don-hang-repository",
   "text": "interface, một bản hợp đồng đặt ở",
   "startMs": 327110,
   "endMs": 329730
  },
  {
   "part": "04-nha-kho-cho-don-hang-repository",
   "text": "phía nghiệp vụ.",
   "startMs": 329730,
   "endMs": 330730
  },
  {
   "part": "04-nha-kho-cho-don-hang-repository",
   "text": "Sách có một mẹo: viết dòng mình",
   "startMs": 330990,
   "endMs": 332970
  },
  {
   "part": "04-nha-kho-cho-don-hang-repository",
   "text": "muốn gọi trước, như thể nhà kho",
   "startMs": 332970,
   "endMs": 335130
  },
  {
   "part": "04-nha-kho-cho-don-hang-repository",
   "text": "đã có sẵn, rồi mới định nghĩa nó.",
   "startMs": 335130,
   "endMs": 337650
  },
  {
   "part": "04-nha-kho-cho-don-hang-repository",
   "text": "Sau đó mới tới các nhà kho cụ thể.",
   "startMs": 338510,
   "endMs": 341230
  },
  {
   "part": "04-nha-kho-cho-don-hang-repository",
   "text": "Kho chạy thật cất đơn vào MySQL.",
   "startMs": 341690,
   "endMs": 344250
  },
  {
   "part": "04-nha-kho-cho-don-hang-repository",
   "text": "Kho dùng khi test chỉ giữ đơn",
   "startMs": 344970,
   "endMs": 346970
  },
  {
   "part": "04-nha-kho-cho-don-hang-repository",
   "text": "trong bộ nhớ, không cần bật database.",
   "startMs": 346970,
   "endMs": 349290
  },
  {
   "part": "04-nha-kho-cho-don-hang-repository",
   "text": "Sau này cần cất sang một hệ",
   "startMs": 350010,
   "endMs": 351630
  },
  {
   "part": "04-nha-kho-cho-don-hang-repository",
   "text": "thống khác qua API, chỉ việc thêm",
   "startMs": 351630,
   "endMs": 354070
  },
  {
   "part": "04-nha-kho-cho-don-hang-repository",
   "text": "một kho nữa.",
   "startMs": 354070,
   "endMs": 354770
  },
  {
   "part": "04-nha-kho-cho-don-hang-repository",
   "text": "Phía nghiệp vụ không cần biết đang",
   "startMs": 355410,
   "endMs": 357390
  },
  {
   "part": "04-nha-kho-cho-don-hang-repository",
   "text": "dùng kho nào.",
   "startMs": 357390,
   "endMs": 358210
  },
  {
   "part": "04-nha-kho-cho-don-hang-repository",
   "text": "Sau lần tách này, hàm đặt hàng",
   "startMs": 359430,
   "endMs": 361270
  },
  {
   "part": "04-nha-kho-cho-don-hang-repository",
   "text": "ban đầu gọn hẳn: lấy giá, tạo",
   "startMs": 361270,
   "endMs": 363450
  },
  {
   "part": "04-nha-kho-cho-don-hang-repository",
   "text": "đơn hàng, cất vào kho, nhớ mã",
   "startMs": 363450,
   "endMs": 365630
  },
  {
   "part": "04-nha-kho-cho-don-hang-repository",
   "text": "đơn, chuyển trang.",
   "startMs": 365630,
   "endMs": 366590
  },
  {
   "part": "04-nha-kho-cho-don-hang-repository",
   "text": "Mọi câu SQL nằm gọn trong một chỗ.",
   "startMs": 366590,
   "endMs": 369950
  },
  {
   "part": "04-nha-kho-cho-don-hang-repository",
   "text": "Đơn hàng là code thuần, không dính framework.",
   "startMs": 370210,
   "endMs": 372850
  },
  {
   "part": "04-nha-kho-cho-don-hang-repository",
   "text": "Và mỗi bên test riêng được.",
   "startMs": 373610,
   "endMs": 375050
  },
  {
   "part": "04-nha-kho-cho-don-hang-repository",
   "text": "Đây là lần tách đầu tiên, và",
   "startMs": 375570,
   "endMs": 377530
  },
  {
   "part": "04-nha-kho-cho-don-hang-repository",
   "text": "các chương sau đều xây tiếp trên nó.",
   "startMs": 377530,
   "endMs": 379430
  },
  {
   "part": "05-doc-khac-voi-ghi",
   "text": "Có một chỗ hay bị bỏ quên:",
   "startMs": 380830,
   "endMs": 383370
  },
  {
   "part": "05-doc-khac-voi-ghi",
   "text": "lúc chỉ cần đọc.",
   "startMs": 383530,
   "endMs": 384730
  },
  {
   "part": "05-doc-khac-voi-ghi",
   "text": "Trang chi tiết e-book chỉ cần mã,",
   "startMs": 384930,
   "endMs": 386710
  },
  {
   "part": "05-doc-khac-voi-ghi",
   "text": "tên và giá.",
   "startMs": 387110,
   "endMs": 388170
  },
  {
   "part": "05-doc-khac-voi-ghi",
   "text": "Nhưng thường ta đưa luôn đối tượng",
   "startMs": 388730,
   "endMs": 390210
  },
  {
   "part": "05-doc-khac-voi-ghi",
   "text": "e-book đầy đủ, kèm cả các hàm",
   "startMs": 390210,
   "endMs": 392290
  },
  {
   "part": "05-doc-khac-voi-ghi",
   "text": "đổi giá, ẩn sản phẩm, đổi trạng thái.",
   "startMs": 392290,
   "endMs": 395050
  },
  {
   "part": "05-doc-khac-voi-ghi",
   "text": "Trang hiển thị chỉ cần nhìn, lại",
   "startMs": 395330,
   "endMs": 397130
  },
  {
   "part": "05-doc-khac-voi-ghi",
   "text": "được cầm cả quyền sửa.",
   "startMs": 397130,
   "endMs": 398770
  },
  {
   "part": "05-doc-khac-voi-ghi",
   "text": "Và cái class ấy phình dần, vì",
   "startMs": 398970,
   "endMs": 401210
  },
  {
   "part": "05-doc-khac-voi-ghi",
   "text": "phải phục vụ cả hai việc.",
   "startMs": 401210,
   "endMs": 402570
  },
  {
   "part": "05-doc-khac-voi-ghi",
   "text": "Sách tách phần đọc ra riêng: một",
   "startMs": 403470,
   "endMs": 405710
  },
  {
   "part": "05-doc-khac-voi-ghi",
   "text": "mô hình chỉ để đọc, mang đúng",
   "startMs": 405710,
   "endMs": 407570
  },
  {
   "part": "05-doc-khac-voi-ghi",
   "text": "mã, tên và giá, lấy qua một",
   "startMs": 407570,
   "endMs": 409930
  },
  {
   "part": "05-doc-khac-voi-ghi",
   "text": "kho chỉ để đọc.",
   "startMs": 409930,
   "endMs": 411170
  },
  {
   "part": "05-doc-khac-voi-ghi",
   "text": "Màn hình cần gì thì đưa đúng",
   "startMs": 411410,
   "endMs": 413070
  },
  {
   "part": "05-doc-khac-voi-ghi",
   "text": "thứ đó, ví dụ giá đã định",
   "startMs": 413070,
   "endMs": 415090
  },
  {
   "part": "05-doc-khac-voi-ghi",
   "text": "dạng sẵn thành chuỗi tiền.",
   "startMs": 415090,
   "endMs": 416550
  },
  {
   "part": "05-doc-khac-voi-ghi",
   "text": "Có một cách nặng hơn tên là",
   "startMs": 416910,
   "endMs": 418950
  },
  {
   "part": "05-doc-khac-voi-ghi",
   "text": "CQRS, tách hẳn hai kho cho đọc và ghi.",
   "startMs": 418950,
   "endMs": 422450
  },
  {
   "part": "05-doc-khac-voi-ghi",
   "text": "Sách không đẩy bạn tới đó, vì",
   "startMs": 422690,
   "endMs": 424690
  },
  {
   "part": "05-doc-khac-voi-ghi",
   "text": "giữ hai kho khớp nhau là cả một việc.",
   "startMs": 424690,
   "endMs": 426730
  },
  {
   "part": "05-doc-khac-voi-ghi",
   "text": "Sách chọn cách nhẹ: vẫn chung một",
   "startMs": 426730,
   "endMs": 429230
  },
  {
   "part": "05-doc-khac-voi-ghi",
   "text": "database, chỉ tách đường đọc, và có",
   "startMs": 429230,
   "endMs": 431970
  },
  {
   "part": "05-doc-khac-voi-ghi",
   "text": "test để hai bên không hiểu lệch dữ liệu.",
   "startMs": 431970,
   "endMs": 434890
  },
  {
   "part": "05-doc-khac-voi-ghi",
   "text": "Gói lại một câu: đọc thì trả",
   "startMs": 435330,
   "endMs": 437610
  },
  {
   "part": "05-doc-khac-voi-ghi",
   "text": "đúng thứ cần đọc.",
   "startMs": 437610,
   "endMs": 438496
  },
  {
   "part": "06-moi-viec-mot-service",
   "text": "Quay lại controller.",
   "startMs": 439750,
   "endMs": 441290
  },
  {
   "part": "06-moi-viec-mot-service",
   "text": "Nó vẫn có xu hướng phình ra,",
   "startMs": 441930,
   "endMs": 443790
  },
  {
   "part": "06-moi-viec-mot-service",
   "text": "vì đó là chỗ ai cũng tiện",
   "startMs": 443970,
   "endMs": 445790
  },
  {
   "part": "06-moi-viec-mot-service",
   "text": "tay nhét thêm việc vào.",
   "startMs": 445790,
   "endMs": 447170
  },
  {
   "part": "06-moi-viec-mot-service",
   "text": "Sách tách mỗi việc của người dùng,",
   "startMs": 447710,
   "endMs": 449390
  },
  {
   "part": "06-moi-viec-mot-service",
   "text": "như đặt hàng, thành một service riêng,",
   "startMs": 449590,
   "endMs": 452290
  },
  {
   "part": "06-moi-viec-mot-service",
   "text": "gọi là Application Service.",
   "startMs": 452310,
   "endMs": 454470
  },
  {
   "part": "06-moi-viec-mot-service",
   "text": "Một service làm đúng một việc, và",
   "startMs": 454750,
   "endMs": 456990
  },
  {
   "part": "06-moi-viec-mot-service",
   "text": "ai cũng gọi được: trang web, API,",
   "startMs": 456990,
   "endMs": 459590
  },
  {
   "part": "06-moi-viec-mot-service",
   "text": "một lệnh chạy nền, hay bài test.",
   "startMs": 460130,
   "endMs": 461810
  },
  {
   "part": "06-moi-viec-mot-service",
   "text": "Đầu vào được gói thành một phiếu",
   "startMs": 462930,
   "endMs": 464410
  },
  {
   "part": "06-moi-viec-mot-service",
   "text": "yêu cầu, sách gọi là command: mã",
   "startMs": 464410,
   "endMs": 466990
  },
  {
   "part": "06-moi-viec-mot-service",
   "text": "khách, các sản phẩm, email.",
   "startMs": 466990,
   "endMs": 468890
  },
  {
   "part": "06-moi-viec-mot-service",
   "text": "Service nhận phiếu, rồi làm lần lượt:",
   "startMs": 469470,
   "endMs": 471990
  },
  {
   "part": "06-moi-viec-mot-service",
   "text": "lấy sản phẩm, kiểm tra còn hàng,",
   "startMs": 472010,
   "endMs": 473990
  },
  {
   "part": "06-moi-viec-mot-service",
   "text": "tính tiền, tạo đơn, cất vào kho.",
   "startMs": 474390,
   "endMs": 476510
  },
  {
   "part": "06-moi-viec-mot-service",
   "text": "Hết hàng thì báo lỗi.",
   "startMs": 477110,
   "endMs": 478970
  },
  {
   "part": "06-moi-viec-mot-service",
   "text": "Xong việc, nó trả lại mã đơn.",
   "startMs": 479170,
   "endMs": 481030
  },
  {
   "part": "06-moi-viec-mot-service",
   "text": "Controller chỉ còn hai việc: đổi yêu",
   "startMs": 481710,
   "endMs": 484150
  },
  {
   "part": "06-moi-viec-mot-service",
   "text": "cầu từ web thành phiếu, và trả",
   "startMs": 484150,
   "endMs": 486210
  },
  {
   "part": "06-moi-viec-mot-service",
   "text": "kết quả về.",
   "startMs": 486210,
   "endMs": 487010
  },
  {
   "part": "06-moi-viec-mot-service",
   "text": "Những thứ service cần, như nhà kho",
   "startMs": 488190,
   "endMs": 490310
  },
  {
   "part": "06-moi-viec-mot-service",
   "text": "hay bộ gửi mail, được đưa vào",
