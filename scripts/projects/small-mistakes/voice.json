  "tailAddedSamples": 14404,
  "phraseRanges": [
    {
      "text": "Trong lớp, bạn trả lời nhầm một câu.",
      "startSeconds": 0.3,
      "endSeconds": 2.2094,
      "scene": 1
    },
    {
      "text": "Trong cuộc họp, bạn nói vấp lúc trình bày.",
      "startSeconds": 2.6486083333333332,
      "endSeconds": 4.847308333333333,
      "scene": 1
    },
    {
      "text": "Chuyện chỉ diễn ra vài giây.",
      "startSeconds": 5.234308333333333,
      "endSeconds": 6.6982083333333335,
      "scene": 1
    },
    {
      "text": "Nhưng tối về, bạn vẫn nhớ từng ánh mắt nhìn mình lúc đó.",
      "startSeconds": 7.035208333333333,
      "endSeconds": 9.961708333333334,
      "scene": 1
    },
    {
      "text": "Chắc họ thấy mình kém lắm. Lẽ ra mình nên im lặng.",
      "startSeconds": 10.674833333333334,
      "endSeconds": 13.831333333333333,
      "scene": 2
    },
    {
      "text": "Bạn tua lại khoảnh khắc ấy, rồi tưởng tượng mọi người cũng đang nhớ nó rõ như mình.",
      "startSeconds": 14.021033333333333,
      "endSeconds": 17.697233333333333,
      "scene": 2
    },
    {
      "text": "Nhưng bạn có nhớ chính xác lần gần nhất người khác nói vấp không?",
      "startSeconds": 18.41035833333333,
      "endSeconds": 21.592458333333333,
      "scene": 3
    },
    {
      "text": "Có lẽ chẳng nhớ nổi.",
      "startSeconds": 22.07945833333333,
      "endSeconds": 23.23785833333333,
      "scene": 3
    },
    {
      "text": "Lúc đó, bạn còn bận nghĩ câu trả lời của mình, hoặc lo đến lượt mình sẽ nói ra sao.",
      "startSeconds": 23.624858333333336,
      "endSeconds": 27.93935833333333,
      "scene": 3
    },
    {
      "text": "Họ có thể nhận ra lỗi của bạn.",
      "startSeconds": 28.652483333333333,
      "endSeconds": 30.37138333333333,
      "scene": 4
    },
    {
      "text": "Nhưng nhận ra không có nghĩa là họ sẽ nhớ mãi.",
      "startSeconds": 30.708383333333334,
      "endSeconds": 32.91108333333333,
      "scene": 4
    },
    {
      "text": "Sai thông tin thì đính chính. Nói chưa rõ thì tập lại.",
      "startSeconds": 33.29808333333334,
      "endSeconds": 36.49079166666667,
      "scene": 4
    },
    {
      "text": "Một lỗi nhỏ cần được sửa, đâu cần trở thành lý do để bạn tự chê mình.",
      "startSeconds": 36.571083333333334,
      "endSeconds": 40.21579166666667,
      "scene": 4
    },
    {
      "text": "Bạn không cần nói hoàn hảo mới đáng được lắng nghe.",
      "startSeconds": 41.01850833333334,
      "endSeconds": 43.33870833333334,
      "scene": 5
    },
    {
      "text": "Lần sau có điều muốn hỏi, có ý kiến muốn góp, đừng để vài giây ngượng ngùng hôm nay giữ bạn im lặng.",
      "startSeconds": 43.82570833333333,
      "endSeconds": 48.59980833333333,
      "scene": 5
    }
  ],
