  "phraseRanges": [
    {
      "text": "Nếu một ngày có thật nhiều tiền, bạn muốn mua lại ngày nào?",
      "startSeconds": 0.3,
      "endSeconds": 3.3098,
      "scene": 1
    },
    {
      "text": "Một buổi chiều còn được ngồi cạnh mẹ?",
      "startSeconds": 4.264258333333333,
      "endSeconds": 6.013333333333334,
      "scene": 1
    },
    {
      "text": "Hay những năm tháng mình còn đủ khỏe để đi bất cứ đâu?",
      "startSeconds": 6.5916999999999994,
      "endSeconds": 9.354600000000001,
      "scene": 1
    },
    {
      "text": "Ta thường hẹn: kiếm đủ tiền rồi sẽ về nhà nhiều hơn.",
      "startSeconds": 10.242600000000001,
      "endSeconds": 13.1623,
      "scene": 2
    },
    {
      "text": "Công việc ổn rồi sẽ chăm sóc bản thân.",
      "startSeconds": 13.683841666666666,
      "endSeconds": 15.800941666666667,
      "scene": 2
    },
    {
      "text": "Cứ thế, những điều quan trọng phải chờ một ngày chưa biết bao giờ tới.",
      "startSeconds": 16.322483333333334,
      "endSeconds": 19.787283333333335,
      "scene": 2
    },
    {
      "text": "Tiền có thể mua một chuyến đi đẹp hơn.",
      "startSeconds": 20.675283333333333,
      "endSeconds": 22.638683333333333,
      "scene": 3
    },
    {
      "text": "Nhưng không mua lại được sức khỏe của năm hai mươi tuổi.",
      "startSeconds": 23.110225,
      "endSeconds": 25.421024999999997,
      "scene": 3
    },
    {
      "text": "Có thể mua một căn nhà lớn, nhưng không giữ mãi những người từng ngồi trong đó.",
      "startSeconds": 25.942566666666664,
      "endSeconds": 29.888666666666666,
      "scene": 3
    },
    {
      "text": "Bạn vẫn cần làm việc, vẫn cần tiền để sống.",
      "startSeconds": 30.826666666666664,
      "endSeconds": 33.21536666666667,
      "scene": 4
    },
    {
      "text": "Nhưng đừng chờ mọi thứ đầy đủ mới dành thời gian cho điều mình quý.",
      "startSeconds": 33.73690833333333,
      "endSeconds": 36.911408333333334,
      "scene": 4
    },
    {
      "text": "Một cuộc hẹn nhỏ hôm nay có thể đáng giá hơn món quà lớn đến quá muộn.",
      "startSeconds": 37.43305,
      "endSeconds": 40.84175,
      "scene": 4
    },
    {
      "text": "Thời gian là vàng.",
      "startSeconds": 41.729749999999996,
      "endSeconds": 42.54105,
      "scene": 5
    },
    {
      "text": "Nhưng vàng còn có thể kiếm thêm.",
      "startSeconds": 43.16249166666667,
      "endSeconds": 44.82789166666667,
      "scene": 5
    },
    {
      "text": "Còn ngày hôm nay, dù giàu đến đâu, bạn cũng chỉ có một lần.",
      "startSeconds": 45.44943333333333,
      "endSeconds": 48.60003333333333,
      "scene": 5
    }
  ],
