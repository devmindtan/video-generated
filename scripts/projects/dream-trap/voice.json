  "tailAddedSamples": 2332,
  "phraseRanges": [
    {
      "text": "Bạn đã tưởng tượng rất rõ ngày mình thành công.",
      "startSeconds": 0.25,
      "endSeconds": 2.4503,
      "scene": 1
    },
    {
      "text": "Làm được gì, sống ra sao, ai sẽ nhìn mình khác đi.",
      "startSeconds": 3.0003,
      "endSeconds": 5.818,
      "scene": 1
    },
    {
      "text": "Nhưng hôm nay, bạn đã làm gì cho điều đó?",
      "startSeconds": 6.368,
      "endSeconds": 8.4815,
      "scene": 1
    },
    {
      "text": "Bạn lưu thêm một video, viết thêm một kế hoạch, rồi thấy mình như vừa tiến bộ.",
      "startSeconds": 9.7815,
      "endSeconds": 13.7777,
      "scene": 2
    },
    {
      "text": "Việc cần làm vẫn nằm đó.",
      "startSeconds": 14.3277,
      "endSeconds": 15.8273,
      "scene": 2
    },
    {
      "text": "Chỉ có cảm giác là bạn đang tiến lên.",
      "startSeconds": 16.3273,
      "endSeconds": 18.2059,
      "scene": 2
    },
    {
      "text": "Đáng ngại hơn là khi kết quả không như ý, bạn chỉ tìm điều muốn nghe.",
      "startSeconds": 19.2059,
      "endSeconds": 22.564300000000003,
      "scene": 3
    },
    {
      "text": "Ai góp ý cũng bị xem là không hiểu.",
      "startSeconds": 23.1143,
      "endSeconds": 25.162000000000003,
      "scene": 3
    },
    {
      "text": "Còn sai sót thì lần nào cũng có lý do.",
      "startSeconds": 25.662000000000003,
      "endSeconds": 27.9003,
      "scene": 3
    },
    {
      "text": "Muốn biết mình đang ở đâu, hãy nhìn vào thứ đã làm xong.",
      "startSeconds": 28.9003,
      "endSeconds": 31.7182,
      "scene": 4
    },
    {
      "text": "Thử ý tưởng với người thật. Hỏi điều gì chưa ổn.",
      "startSeconds": 32.2682,
      "endSeconds": 34.7402,
      "scene": 4
    },
    {
      "text": "Một lời góp ý khó nghe có thể giúp bạn sửa điều mình đã bỏ sót.",
      "startSeconds": 35.2902,
      "endSeconds": 38.4827,
      "scene": 4
    },
    {
      "text": "Cứ giữ giấc mơ của bạn.",
      "startSeconds": 39.4827,
      "endSeconds": 40.8161,
      "scene": 5
    },
    {
      "text": "Nhưng đừng lấy điều mình sẽ làm để thay cho điều mình chưa làm.",
      "startSeconds": 41.366099999999996,
      "endSeconds": 44.161699999999996,
      "scene": 5
    },
    {
      "text": "Tương lai ấy cần một việc được bắt đầu ngay hôm nay.",
      "startSeconds": 44.7617,
      "endSeconds": 47.202799999999996,
      "scene": 5
    }
  ],
