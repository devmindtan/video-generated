  "phraseRanges": [
    {
      "text": "Điện thoại hiện tên mẹ.",
      "startSeconds": 0.3,
      "endSeconds": 1.3975,
      "scene": 1
    },
    {
      "text": "Bạn nhìn qua rồi úp xuống: Để lát gọi lại.",
      "startSeconds": 2.32075,
      "endSeconds": 4.60355,
      "scene": 1
    },
    {
      "text": "Chẳng có chuyện gì nghiêm trọng. Bạn chỉ đang bận, như mọi ngày.",
      "startSeconds": 5.5768,
      "endSeconds": 8.603,
      "scene": 1
    },
    {
      "text": "Ta dễ dành thời gian cho những việc có hạn chót.",
      "startSeconds": 9.82625,
      "endSeconds": 12.32925,
      "scene": 2
    },
    {
      "text": "Còn một bữa cơm với nhà, một cuộc hỏi han… lại cứ để sau.",
      "startSeconds": 13.2525,
      "endSeconds": 16.5278,
      "scene": 2
    },
    {
      "text": "Vì nghĩ người thân vẫn luôn ở đó.",
      "startSeconds": 17.45105,
      "endSeconds": 19.222450000000002,
      "scene": 2
    },
    {
      "text": "Rồi đến một ngày, bạn chỉ muốn nghe lại câu: Ăn cơm chưa con?",
      "startSeconds": 20.4957,
      "endSeconds": 23.5762,
      "scene": 3
    },
    {
      "text": "Cầm điện thoại lên, mới nhận ra người từng gọi cho mình mỗi tối… giờ không thể gọi nữa.",
      "startSeconds": 24.69945,
      "endSeconds": 29.23525,
      "scene": 3
    },
    {
      "text": "Điều làm bạn tiếc không phải là chưa mua được món quà đắt tiền.",
      "startSeconds": 31.357791666666664,
      "endSeconds": 34.218691666666665,
      "scene": 4
    },
    {
      "text": "Mà là từng có thể ngồi lại thêm một chút, nghe hết một câu chuyện… nhưng đã vội đi.",
      "startSeconds": 35.191941666666665,
      "endSeconds": 39.25284166666667,
      "scene": 4
    },
    {
      "text": "Nếu vẫn còn người để gọi, còn một nơi để về,",
      "startSeconds": 40.526091666666666,
      "endSeconds": 42.78959166666667,
      "scene": 5
    },
    {
      "text": "đừng để mọi lời thương chỉ được nói bằng hai chữ giá như.",
      "startSeconds": 43.76284166666667,
      "endSeconds": 46.599941666666666,
      "scene": 5
    }
  ],
